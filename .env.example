# --- Google スプレッドシート（サービスアカウント） ---
# サービスアカウント鍵のJSONファイルの中身をまるごと1行の文字列として入れる。
# client_email / private_key を含む。絶対にフロント(ブラウザ)へ出さない。
GOOGLE_SERVICE_ACCOUNT_JSON=

# 投稿・公開データを置いているスプレッドシートのID
# https://docs.google.com/spreadsheets/d/<この部分>/edit
SHEET_ID=

# --- 投稿受付 ---
# 'false' にすると投稿フォームを閉じる（未設定なら受付中）
NEXT_PUBLIC_SUBMISSIONS_OPEN=
